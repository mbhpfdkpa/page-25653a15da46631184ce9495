ock;margin-top: 0.5rem;font-size: 0.85rem;font-weight: 700;color: #666666;background-color: #f0f0f0;padding: 0.2rem 0.5rem}\n    .plan-features-list {list-style: none;margin-bottom: 2rem;flex-grow: 1;display: flex;flex-direction: column;gap: 0.85rem}\n    .plan-features-list li {font-size: 0.95rem;font-weight: 600;color: #222222;display: flex;align-items: flex-start;gap: 0.5rem}\n    .plan-features-list li::before {content: \"▪\";color: #ff3e00;font-size: 1.2rem;line-height: 1}\n    .plan-action-link {display: block;text-align: center;padding: 1rem;border: 2px solid #111111;background-color: #111111;color: #ffffff;font-weight: 800;font-size: 1rem;transition: background-color 0.15s ease, color 0.15s ease}\n    .plan-action-link:hover {background-color: #ff3e00;border-color: #ff3e00}\n    .plan-card:not(.is-featured) .plan-action-link {background-color: #ffffff;color: #111111}\n    .plan-card:not(.is-featured) .plan-action-link:hover {background-color: #111111;color: #ffffff}\n\n    /* 团队附加卡片 */\n    .team-plan-strip {border: 3px solid #111111;background-color: #ffffff;padding: 2rem;display: flex;justify-content: space-between;align-items: center;gap: 2rem}\n    .team-info {flex: 1}\n    .team-info h3 {font-size: 1.35rem;font-weight: 900;margin-bottom: 0.5rem}\n    .team-info p {color: #555555;font-size: 0.95rem;line-height: 1.6}\n    .team-meta {text-align: right;flex-shrink: 0}\n    .team-price {font-size: 2rem;font-weight: 900;color: #111111;display: block}\n    .team-annual {font-size: 0.85rem;color: #666666;display: block;margin-bottom: 0.75rem}\n    .team-btn {display: inline-block;padding: 0.65rem 1.5rem;border: 2px solid #111111;font-weight: 800;background-color: #ffffff;color: #111111}\n    .team-btn:hover {background-color: #111111;color: #ffffff}\n\n    /* 客户端与连接支持 */\n    .clients-card-box {border: 3px solid #111111;background-color: #ffffff;padding: 2.25rem 2rem}\n    .clients-card-box p.intro {font-size: 1.05rem;color: #333333;margin-bottom: 2rem;max-width: 820px}\n    .clients-platform-grid {display: grid;grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));gap: 1.25rem}\n    .client-unit {border: 2px solid #111111;padding: 1.25rem;background-color: #fafafa}\n    .client-unit h4 {font-size: 1.1rem;font-weight: 900;margin-bottom: 0.5rem;display: flex;justify-content: space-between;align-items: center}\n    .client-unit p {font-size: 0.85rem;color: #666666;margin-bottom: 1rem;line-height: 1.5}\n    .client-link {display: inline-block;font-size: 0.85rem;font-weight: 800;color: #ff3e00;text-decoration: underline}\n\n    /* 上手步骤 */\n    .guide-steps-grid {display: grid;grid-template-columns: repeat(4, 1fr);gap: 1.25rem}\n    .guide-step-card {border: 3px solid #111111;background-color: #ffffff;padding: 1.75rem 1.25rem;display: flex;flex-direction: column}\n    .step-index {font-family: monospace;font-size: 2rem;font-weight: 900;color: #ff3e00;line-height: 1;margin-bottom: 1rem}\n    .guide-step-card h3 {font-size: 1.15rem;font-weight: 900;margin-bottom: 0.75rem;line-height: 1.35}\n    .guide-step-card p {font-size: 0.9rem;color: #555555;line-height: 1.6}\n\n    /* 对话气泡式 FAQ */\n    .faq-dialogue-list {display: flex;flex-direction: column;gap: 2.25rem}\n    .dialogue-thread {display: flex;flex-direction: column;gap: 0.85rem}\n    .bubble-ask {align-self: flex-start;max-width: 85%;border: 2px solid #111111;background-color: #ffffff;padding: 1.25rem 1.5rem}\n    .bubble-reply {align-self: flex-end;max-width: 85%;border: 3px solid #111111;background-color: #ffffff;padding: 1.5rem 1.75rem;border-left: 6px solid #ff3e00}\n    .bubble-sender {font-size: 0.75rem;font-weight: 900;text-transform: uppercase;letter-spacing: 0.08em;margin-bottom: 0.35rem;color: #777777}\n    .bubble-reply .bubble-sender {color: #ff3e00}\n    .bubble-ask p {font-size: 1.05rem;font-weight: 800;color: #111111}\n    .bubble-reply p {font-size: 0.95rem;color: #222222;line-height: 1.7}\n\n    /* 底部声明 */\n    .site-footer-bar {border-top: 3px solid #111111;padding-top: 2rem;margin-top: 5rem;display: flex;justify-content: space-between;align-items: center;font-size: 0.85rem;color: #666666}\n\n    /* 响应式调整 */\n    @media (max-width: 992px) {.page-layout {\n        flex-direction: column;}\n      .side-directory {\n        width: 100%;height: auto;position: static;border-right: none;border-bottom: 3px solid #111111;padding: 1.5rem;}\n      .vertical-menu {\n        flex-direction: row;flex-wrap: wrap;gap: 0.5rem;margin: 1rem 0;}\n      .vertical-menu li a {\n        padding: 0.4rem 0.6rem;}\n      .content-stream {\n        padding: 2rem 1.5rem;}\n      .poster-hero {\n        padding: 2rem 1.5rem;}\n      .plans-contrast-wrapper {\n        grid-template-columns: 1fr;}\n      .guide-steps-grid {\n        grid-template-columns: 1fr 1fr;}\n      .team-plan-strip {\n        flex-direction: column;align-items: flex-start;}\n      .team-meta {\n        text-align: left;}}\n\n    @media (max-width: 600px) {\n      .guide-steps-grid {grid-template-columns: 1fr}\n      .bubble-ask, .bubble-reply {max-width: 100%}\n      .site-footer-bar {flex-direction: column;gap: 1rem;align-items: flex-start}\n    }\n  </style><div class=\"page-layout\">\n\n    \n    <aside class=\"side-directory\">\n      <div>\n        <div class=\"side-brand-meta\">\n          GOGO ARCHIVE\n          <span class=\"side-tagline\">朋友间的连网随行手记</span>\n        </div>\n        <ul class=\"vertical-menu\">\n          <li><a href=\"#about\"><span class=\"menu-num\">01</span> 了解伙伴</a></li>\n          <li><a href=\"#plans\"><span class=\"menu-num\">02</span> 挑选计划</a></li>\n          <li><a href=\"#clients\"><span class=\"menu-num\">03</span> 设备支持</a></li>\n          <li><a href=\"#guide\"><span class=\"menu-num\">04</span> 上手步骤</a></li>\n          <li><a href=\"#faq\"><span class=\"menu-num\">05</span> 答疑对话</a></li>\n        </ul>\n      </div>\n      <div class=\"side-footer\">\n        版本编号 8689<br>\n        保持清晰、利落与真诚。<br>\n        随时为你在线撑腰。\n      </div>\n    </aside>\n\n    \n    <main class=\"content-stream\">\n\n      \n      <section class=\"poster-hero\" id=\"about\">\n        <div class=\"poster-header-meta\">\n          <span>PORTAL // READY FOR DEPARTURE</span>\n          <span class=\"badge-accent\">随时随地 · 即开即连</span>\n        </div>\n        <h1 class=\"brand-title\">GOGO</h1>\n        <p class=\"hero-lead-text\">\n          嗨，朋友！别再为打不开的网页和反复转圈的视频烦心了。GOGO 就像你身旁随时待命的技术好友，把一切配置整理妥当，只等你轻轻一点，立刻出发。\n        </p>\n        <p class=\"hero-note\">\n          我们不做令人头疼的花哨噱头，只专注于让你在写代码、查文献、追剧看长视频或与远方朋友联络时，拥有舒心自在的连接体验。想去哪里，GOGO 陪你直达。\n        </p>\n      </section>\n\n      \n      <section class=\"section-block\" id=\"plans\">\n        <div class=\"section-heading-bar\">\n          <span class=\"section-mark\">02 //</span>\n          <h2>选个合拍的计划</h2>\n        </div>\n\n        <div class=\"plans-contrast-wrapper\">\n          \n          <article class=\"plan-card\">\n            <h3>基础版</h3>\n            <p>轻度查资料与日常闲逛的务实选择</p>\n            <div class=\"plan-price-box\">\n              <div class=\"plan-main-price\">¥15<span> / 月</span></div>\n              <span class=\"plan-annual-tag\">按年付仅需 ¥150/年</span>\n            </div>\n            <ul class=\"plan-features-list\">\n              <li>每月 100GB 充沛流量配额</li>\n              <li>支持 3 台设备同时在线使用</li>\n              <li>顺畅解锁基础主流流媒体服务</li>\n              <li>接入标准节点池，满足日常查阅</li>\n            </ul>\n            <a href=\"#\" class=\"plan-action-link\">选择基础版</a>\n          </article>\n\n          \n          <article class=\"plan-card is-featured\">\n            <span class=\"featured-label\">★ 朋友力荐 · 热门首选</span>\n            <h3>旗舰版</h3>\n            <p>影音发烧友、跨区协作与游戏玩家首选</p>\n            <div class=\"plan-price-box\">\n              <div class=\"plan-main-price\">¥35<span> / 月</span></div>\n              <span class=\"plan-annual-tag\">按年付仅需 ¥350/年（立省两月）</span>\n            </div>\n            <ul class=\"plan-features-list\">\n              <li>每月 300GB 宽裕流量，告别紧绷感</li>\n              <li>支持 5 台个人全套设备同时在线</li>\n              <li>全节点原生流媒体解锁，追剧随心看</li>\n              <li>优质专线路由，游戏与大文件更顺畅</li>\n              <li>7×24 优先响应工单支持，遇事随时有人帮</li>\n            </ul>\n            <a href=\"#\" class=\"plan-action-link\">开启旗舰版体验</a>\n          </article>\n        </div>\n\n        \n        <article class=\"team-plan-strip\">\n          <div class=\"team-info\">\n            <div>STUDIO &amp; TEAM // 团队协同版</div>\n            <h3>团队版</h3>\n            <p>\n              每月配备 1000GB 充沛流量，允许多达 20 台设备协同在线；享专属高带宽资源通道，支持按需定制团队路由，更有专属服务经理一路跟进，适合小型团队或合租伙伴。\n            </p>\n          </div>\n          <div class=\"team-meta\">\n            <span class=\"team-price\">¥85<span> / 月</span></span>\n            <span class=\"team-annual\">按年付仅需 ¥850/年</span>\n            <a href=\"#\" class=\"team-btn\">咨询团队版</a>\n          </div>\n        </article>\n      </section>\n\n      \n      <section class=\"section-block\" id=\"clients\">\n        <div class=\"section-heading-bar\">\n          <span class=\"section-mark\">03 //</span>\n          <h2>多平台设备灵活兼容</h2>\n        </div>\n        <div class=\"clients-card-box\">\n          <p class=\"intro\">\n            在 GOGO，我们不搞封闭专有的软件捆绑。我们拥抱开源与通用标准，无论你喜欢使用哪一款成熟通用的连接工具，直接导入专属配置链接就能轻松跑起来。\n          </p>\n          <div class=\"clients-platform-grid\">\n            <div class=\"client-unit\">\n              <h4>Windows <span>PC</span></h4>\n              <p>支持各类标准客户端，导入订阅即可载入节点列表并使用。</p>\n              <a href=\"#\" class=\"client-link\">查看配置说明 →</a>\n            </div>\n            <div class=\"client-unit\">\n              <h4>macOS <span>Apple</span></h4>\n              <p>适配桌面通用代理工具，随开随走，不扰乱系统既有网络环境。</p>\n              <a href=\"#\" class=\"client-link\">查看配置说明 →</a>\n            </div>\n            <div class=\"client-unit\">\n              <h4>iOS / iPadOS <span>Mobile</span></h4>\n              <p>配合主流通用应用，扫描或粘贴链接即可快速同步所有可用入口。</p>\n              <a href=\"#\" class=\"client-link\">查看配置说明 →</a>\n            </div>\n            <div class=\"client-unit\">\n              <h4>Android <span>Device</span></h4>\n              <p>开放生态适配多种常见辅助工具，分应用分流随心定义。</p>\n              <a href=\"#\" class=\"client-link\">查看配置说明 →</a>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      \n      <section class=\"section-block\" id=\"guide\">\n        <div class=\"section-heading-bar\">\n          <span class=\"section-mark\">04 //</span>\n          <h2>四步轻松上手</h2>\n        </div>\n        <div class=\"guide-steps-grid\">\n          <article class=\"guide-step-card\">\n            <div class=\"step-index\">01</div>\n            <h3>挑选适宜的计划</h3>\n            <p>根据你手头的设备数量和平常的流量开销，挑一个看着顺眼的套餐，在后台拿到专属订阅串。</p>\n          </article>\n          <article class=\"guide-step-card\">\n            <div class=\"step-index\">02</div>\n            <h3>打开通用工具</h3>\n            <p>在你的手机或电脑上启动你平时习惯的通用网络工具，界面清清爽爽，随时待命。</p>\n          </article>\n          <article class=\"guide-step-card\">\n            <div class=\"step-index\">03</div>\n            <h3>粘贴并同步</h3>\n            <p>将属于你的配置链接粘贴进软件里，轻点一下同步，所有可用线路就会整整齐齐排好。</p>\n          </article>\n          <article class=\"guide-step-card\">\n            <div class=\"step-index\">04</div>\n            <h3>轻点连接即出发</h3>\n            <p>挑一个延迟低或离你近的节点，开关一开，尽情开始你的网络冲浪与工作吧。</p>\n          </article>\n        </div>\n      </section>\n\n      \n      <section class=\"section-block\" id=\"faq\">\n        <div class=\"section-heading-bar\">\n          <span class=\"section-mark\">05 //</span>\n          <h2>朋友间的连网问答</h2>\n        </div>\n\n        <div class=\"faq-dialogue-list\">\n          \n          <div class=\"dialogue-thread\">\n            <div class=\"bubble-ask\">\n              <div class=\"bubble-sender\">来自朋友的提问 // QUESTION</div>\n              <p>“我平时就是查阅学习文献、偶尔看看网络视频，选基础版够不够用呀？”</p>\n            </div>\n            <div class=\"bubble-reply\">\n              <div class=\"bubble-sender\">GOGO 的心底话 // ANSWER</div>\n              <p>完全足够啦！基础版每月有 100GB 流量，看网页查文献绰绰有余，哪怕每天下班看会儿视频也能轻松支撑整月。如果你之后突然迷上高清大片或者对外服游戏有专线要求，随时在后台补差价升级旗舰版就好，一点都不亏。</p>\n            </div>\n          </div>\n\n          \n          <div class=\"dialogue-thread\">\n            <div class=\"bubble-ask\">\n              <div class=\"bubble-sender\">来自朋友的提问 // QUESTION</div>\n              <p>“我平时不太精通计算机网络技术，自己动手配置起来会不会很折腾？”</p>\n            </div>\n            <div class=\"bubble-reply\">\n              <div class=\"bubble-sender\">GOGO 的心底话 // ANSWER</div>\n              <p>放宽心，整个过程其实就跟‘复制一段文字、粘贴进搜索框’一样容易。你只需要把专属的一串订阅网址粘到常用工具里点个更新，软件自己就会把各种参数调好。要是真卡在哪一步，直接给我们留个言，我们随时替你搭把手。</p>\n            </div>\n          </div>\n\n          \n          <div class=\"dialogue-thread\">\n            <div class=\"bubble-ask\">\n              <div class=\"bubble-sender\">来自朋友的提问 // QUESTION</div>\n              <p>“如果我想和室友或者家里人一起用，会被限制或者封锁账号吗？”</p>\n            </div>\n            <div class=\"bubble-reply\">\n              <div class=\"bubble-sender\">GOGO 的心底话 // ANSWER</div>\n              <p>完全合情合理！每个套餐都清清楚楚标明了同时在线的设备上限（比如基础版 3 台、旗舰版 5 台、团队版 20 台）。只要同一个瞬间在线的设备数量在限额以内，你和谁一起用都完全没问题，大大方方享受网络就行。</p>\n            </div>\n          </div>\n\n          \n          <div class=\"dialogue-thread\">\n            <div class=\"bubble-ask\">\n              <div class=\"bubble-sender\">来自朋友的提问 // QUESTION</div>\n              <p>“偶尔遇上连不上网络或者个别节点刷不出来，我该先怎么自查？”</p>\n            </div>\n            <div class=\"bubble-reply\">\n              <div class=\"bubble-sender\">GOGO 的心底话 // ANSWER</div>\n              <p>遇到这种情况别慌张，通常两步就能搞定：第一步是轻点客户端里的‘更新订阅’刷新一下最新地址；第二步是切到列表里另一个就近节点。绝大部分偶发小问题就解决了。如果依然不对劲，随时给我们工单留言，我们在后台时刻帮你盯着呢。</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      \n      <footer class=\"site-footer-bar\">\n        <div>© GOGO. 保留所有真诚与探索的权利。与朋友同行，步履不停。</div>\n        <div>保持好奇 // 探索广阔天地</div>\n      </footer>\n\n    </main>\n  </div>",
